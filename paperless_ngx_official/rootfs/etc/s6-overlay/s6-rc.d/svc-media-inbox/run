#!/command/with-contenv /usr/bin/bash
# shellcheck shell=bash
# Scans aus Home Assistant (/media/paperless-eingang) an Paperless übergeben.
if [[ "${HA_MEDIA_INBOX_ENABLED:-false}" != "true" ]]; then
	exec sleep infinity
fi
cd "${PAPERLESS_SRC_DIR:-/usr/src/paperless/src}" || exit 1
exec s6-setuidgid paperless python3 /usr/local/bin/ha-media-inbox.py
